# salin jadi .env lalu sesuaikan
# buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-64-karakter-acak

APP_ENV=development
# lokasi berkas data JSON, relatif ke folder backend
DATA_FILE=data/cakraspace.json
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports

TOKEN_MINUTES=120
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Jakarta

# kosongkan untuk memakai turunan SECRET_KEY
PAYMENT_WEBHOOK_SECRET=
# dipakai cron untuk memanggil POST /api/v1/internal/jobs/run
CRON_SECRET=
